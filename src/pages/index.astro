---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { contact, equipmentImages, projectSketches, services } from '../data/site';

const persianDigits = (value: string) => value.replace(/\d/g, (digit) => '۰۱۲۳۴۵۶۷۸۹'[Number(digit)]);
const portfolio = [
  { ...projectSketches[0], title: 'طراحی و ساخت قطعه صنعتی', image: projectSketches[0].src },
  { ...projectSketches[1], title: 'طراحی قالب تولیدی', image: projectSketches[1].src },
  ...equipmentImages.slice(1, 5).map((photo, index) => ({ src: photo.src, alt: photo.alt, title: `نمونهٔ پروژه ${index + 1}`, image: photo.src })),
];
---

<BaseLayout>
  <SiteNavigation />
  <main id="main-content">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <img class="hero__background" src="/images/home/Industrial%20Warehouse%20Architectural%20Sketch.png" alt="" fetchpriority="high" />
      <div class="hero__overlay"></div>
      <div class="hero__content">
        <p class="hero__kicker"><span class="hero__status-dot" aria-hidden="true"></span><span class="hero__established">تأسیس ۱۳۶۲</span></p>
        <h1 id="hero-title" aria-label="خدمات صنعتی محمدی‌نیا"><span class="hero__title-main">خدمات صنعتی</span><span class="hero__title-name"><span class="hero__title-name--desktop">محمدی‌نیا</span><span class="hero__title-name--mobile" aria-hidden="true">مـــحـمـــدی‌نــیـــا</span></span></h1>
        <p class="hero__lead">شرکت خدمات صنعتی محمدی‌نیا از طراحی تا ساخت قطعات صنعتی شریک تجاری شما در مسیر فعالیت صنعتی شما.</p>
        <a class="hero__scroll read-more-swap" href="#about" aria-label="رفتن به درباره ما">
          <svg class="read-more-arrow read-more-arrow-left" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <span class="read-more-label">درباره ما</span>
          <svg class="read-more-arrow read-more-arrow-right" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>

    <section class="about section-shell full-section" id="about" aria-labelledby="about-title">
      <div class="about__visual"><img src="/images/equipment/machine-0066.jpg" alt="نمایی از محیط کار صنعتی" loading="lazy" /><span>روایت یک مسیر صنعتی</span></div>
      <div class="about__copy">
        <p class="eyebrow">درباره مجموعه</p>
        <h2 id="about-title">داستانی از<br />دقت و تجربه</h2>
        <p>شرکت خدمات صنعتی محمدی‌نیا از سال ۱۳۶۲ در کنار کسب‌وکارهای صنعتی ایستاده است. داستان ما با ساخت ابزار و قالب آغاز شد و با هر پروژه، تجربه‌ای تازه در مسیر تولید شکل گرفت.</p>
        <p>امروز مجموعه‌ای از خدمات طراحی، ماشین‌کاری و تولید قطعات را کنار هم آورده‌ایم تا ایده‌ها با دقت به محصول تبدیل شوند. این متن در نسخهٔ نهایی با داستان واقعی شرکت جایگزین می‌شود.</p>
        <a class="text-link" href="#services">آشنایی با خدمات <span aria-hidden="true">←</span></a>
      </div>
    </section>

    <section class="services full-section" id="services" aria-labelledby="services-title">
      <div class="section-shell">
        <header class="section-heading">
          <div><p class="eyebrow">آنچه انجام می‌دهیم</p><h2 id="services-title">خدمات ما</h2></div>
          <p>از ایده و طراحی تا ساخت قطعه؛ برای هر مرحله از مسیر تولید، همراه شما هستیم.</p>
        </header>
        <div class="service-cards">
          {services.map((service, index) => (
            <details class="service-item" id={`service-${service.id}`} data-service-details>
              <summary>
                <span class="service-card__image"><img src={equipmentImages[index % equipmentImages.length].src} alt="" loading="lazy" /></span>
                <span class="service-card__body"><strong class="service-item__title">{service.title}</strong><span class="service-item__description">{service.shortDescription}</span><span class="service-item__open">توضیحات <span aria-hidden="true">↗</span></span></span>
              </summary>
              <div class="service-detail-content">
                <img class="service-detail__image" src={equipmentImages[index % equipmentImages.length].src} alt={`تصویری مرتبط با ${service.title}`} loading="lazy" />
                <div class="service-detail__copy">
                  <p class="eyebrow">خدمات صنعتی محمدی‌نیا</p>
                  <h2>{service.title}</h2>
                  <p class="service-dialog__intro">{service.description}</p>
                  <div class="service-dialog__columns">
                    <div><h3>توانمندی‌ها</h3><ul>{service.capabilities.map((item) => <li>{item}</li>)}</ul></div>
                    <div><h3>صنایع مرتبط</h3><ul>{service.industries.map((item) => <li>{item}</li>)}</ul></div>
                  </div>
                  <a class="button button--primary" href="#contact">درخواست مشاوره <span aria-hidden="true">←</span></a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="projects full-section" id="projects" aria-labelledby="projects-title">
      <div class="section-shell">
        <header class="section-heading">
          <div><p class="eyebrow">از نزدیک ببینید</p><h2 id="projects-title">نمونه‌کارها</h2></div>
          <div class="project-controls" aria-label="ناوبری نمونه‌کارها"><button type="button" data-project-scroll="-1" aria-label="نمونه‌کار قبلی">←</button><button type="button" data-project-scroll="1" aria-label="نمونه‌کار بعدی">→</button></div>
        </header>
        <div class="project-grid" id="project-track">
          {portfolio.map((project, index) => (
            <figure class="project-card" tabindex="0">
              <div class="project-card__image"><img src={project.image} alt={project.alt} loading="lazy" /></div>
              <figcaption><span>پروژهٔ ۰{index + 1}</span><strong>{project.title}</strong><small aria-hidden="true">↗</small></figcaption>
            </figure>
          ))}
        </div>
        <p class="projects__hint">برای دیدن جزئیات، نشانگر را روی تصویر ببرید</p>
      </div>
    </section>

    <section class="contact full-section" id="contact" aria-labelledby="contact-title">
      <div class="section-shell contact__layout">
        <div class="contact__main">
          <p class="eyebrow">با ما در ارتباط باشید</p>
          <h2 id="contact-title">پروژهٔ بعدی شما<br />از یک گفت‌وگو شروع می‌شود.</h2>
          <p>برای دریافت مشاوره یا شروع همکاری، پیام خود را برای ما بفرستید.</p>
          <form class="contact-form" action={`mailto:${contact.email}`} method="post" enctype="text/plain">
            <label>نام و نام خانوادگی<input name="name" autocomplete="name" placeholder="نام شما" required /></label>
            <label>ایمیل<input type="email" name="email" autocomplete="email" placeholder="name@example.com" required dir="ltr" /></label>
            <label class="contact-form__message">پیام شما<textarea name="message" rows="3" placeholder="کمی دربارهٔ نیازتان بنویسید" required></textarea></label>
            <button class="button button--primary" type="submit">ارسال پیام <span aria-hidden="true">←</span></button>
          </form>
        </div>
        <aside class="contact__details" aria-label="اطلاعات تماس">
          <div class="contact__mark" aria-hidden="true">م</div>
          <p>خدمات صنعتی<br />محمدی‌نیا</p>
          <div><span>ایمیل</span><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></div>
          <div><span>شماره تماس</span>{contact.mobile.map((phone) => <a href={`tel:${phone}`} dir="ltr">{persianDigits(phone)}</a>)}</div>
          <div><span>تلفن دفتر</span>{contact.office.map((phone) => <a href={`tel:${phone}`} dir="ltr">{persianDigits(phone)}</a>)}</div>
          <small>© خدمات صنعتی محمدی‌نیا</small>
        </aside>
      </div>
    </section>
  </main>

  <dialog class="service-dialog" id="service-dialog" aria-label="جزئیات خدمت">
    <button class="service-dialog__close" type="button" aria-label="بستن جزئیات">×</button>
    <div class="service-dialog__body" id="service-dialog-body"></div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#service-dialog');
    const dialogBody = document.querySelector<HTMLElement>('#service-dialog-body');
    const closeButton = document.querySelector<HTMLButtonElement>('.service-dialog__close');
    let opener: HTMLElement | null = null;
    let pushedModalHistory = false;

    function openService(id: string, source?: HTMLElement, updateHistory = false) {
      const details = document.getElementById(`service-${id}`) as HTMLDetailsElement | null;
      const content = details?.querySelector<HTMLElement>('.service-detail-content');
      if (!dialog || !dialogBody || !details || !content) return;
      opener = source ?? details.querySelector('summary');
      dialogBody.replaceChildren(content.cloneNode(true));
      const title = dialogBody.querySelector('h2');
      if (title) { title.id = 'service-dialog-title'; dialog.setAttribute('aria-labelledby', title.id); }
      details.open = false;
      if (!dialog.open) dialog.showModal();
      if (updateHistory) { history.pushState({ serviceDialog: true }, '', `#service-${id}`); pushedModalHistory = true; }
      closeButton?.focus();
    }

    function closeService(useHistory = true) {
      if (!dialog?.open) return;
      dialog.close();
      if (pushedModalHistory && useHistory) { pushedModalHistory = false; history.back(); }
      else if (location.hash.startsWith('#service-')) history.replaceState(history.state, '', `${location.pathname}${location.search}`);
      opener?.focus();
    }

    dialogBody?.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href="#contact"]') : null;
      if (!target) return;
      event.preventDefault(); closeService(false); history.pushState({}, '', '#contact');
      document.querySelector('#contact')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
    document.querySelectorAll<HTMLDetailsElement>('[data-service-details]').forEach((details) => details.addEventListener('toggle', () => {
      if (details.open) openService(details.id.replace('service-', ''), details.querySelector('summary') ?? undefined, true);
    }));
    closeButton?.addEventListener('click', () => closeService());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeService(); });
    dialog?.addEventListener('close', () => opener?.focus());
    window.addEventListener('popstate', () => {
      if (location.hash.startsWith('#service-')) openService(location.hash.slice('#service-'.length), undefined, false);
      else if (dialog?.open) { pushedModalHistory = false; closeService(false); }
    });
    if (location.hash.startsWith('#service-')) openService(location.hash.slice('#service-'.length), undefined, false);

    document.querySelectorAll<HTMLButtonElement>('[data-project-scroll]').forEach((button) => button.addEventListener('click', () => {
      const track = document.querySelector<HTMLElement>('#project-track');
      const card = track?.querySelector<HTMLElement>('.project-card');
      if (track && card) track.scrollBy({ left: Number(button.dataset.projectScroll) * (card.offsetWidth + 28), behavior: 'smooth' });
    }));

    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.rail-links a[href^="#"], .mobile-nav a[href^="#"]');
    const sections = [...new Set([...sectionLinks].map((link) => document.querySelector<HTMLElement>(link.hash)).filter((section): section is HTMLElement => !!section))];
    const updateNavigation = () => {
      const marker = window.scrollY + window.innerHeight * 0.42;
      const active = [...sections].reverse().find((section) => section.offsetTop <= marker) ?? sections[0];
      sectionLinks.forEach((link) => {
        const current = link.hash === `#${active?.id}`;
        link.classList.toggle('is-active', current);
        if (current) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', updateNavigation, { passive: true });
    window.addEventListener('resize', updateNavigation);
    updateNavigation();
  </script>
</BaseLayout>
