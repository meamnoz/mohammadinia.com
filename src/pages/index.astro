---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { contact, equipmentImages, projectSketches, services } from '../data/site';

const persianDigits = (value: string) => value.replace(/\d/g, (digit) => '۰۱۲۳۴۵۶۷۸۹'[Number(digit)]);
const portfolio = [
  { ...projectSketches[0], title: 'طراحی و ساخت قطعه صنعتی', image: projectSketches[0].src },
  { ...projectSketches[1], title: 'طراحی قالب تولیدی', image: projectSketches[1].src },
  ...equipmentImages.slice(1, 5).map((photo, index) => ({ src: photo.src, alt: photo.alt, title: `نمونهٔ پروژه ${index + 1}`, image: photo.src })),
];
---

<BaseLayout>
  <SiteNavigation />
  <main id="main-content">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <img class="hero__background" src="/images/home/Industrial%20Warehouse%20Architectural%20Sketch.png" alt="" fetchpriority="high" />
      <div class="hero__overlay"></div>
      <div class="hero__content">
        <p class="hero__kicker"><span class="hero__status-dot" aria-hidden="true"></span><span class="hero__established">تأسیس ۱۳۶۲</span></p>
        <h1 id="hero-title" aria-label="خدمات صنعتی محمدی‌نیا"><span class="hero__title-main">خدمات صنعتی</span><span class="hero__title-name"><span class="hero__title-name--desktop">محمدی‌نیا</span><span class="hero__title-name--mobile" aria-hidden="true">مـــحـمـــدی‌نــیـــا</span></span></h1>
        <p class="hero__lead">شرکت خدمات صنعتی محمدی‌نیا از طراحی تا ساخت قطعات صنعتی شریک تجاری شما در مسیر فعالیت صنعتی شما.</p>
        <a class="hero__scroll read-more-swap" href="#about" aria-label="رفتن به درباره ما">
          <svg class="read-more-arrow read-more-arrow-left" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <span class="read-more-label">درباره ما</span>
          <svg class="read-more-arrow read-more-arrow-right" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>

    <section class="about full-section" id="about" aria-labelledby="about-title">
      <div class="about__copy">
        <p class="eyebrow">دربارهٔ ما</p>
        <h2 id="about-title">روایتی کوتاه از شکل‌گیری و فعالیت</h2>
        <p>ما فعالیت‌مان را در سال ۱۳۶۲، از یک کارگاه کوچک آغاز کردیم. نسل اول خانواده ساخت قالب و قطعات ساده را بر عهده داشت. کارگاه با یک کارگر شروع شد و با گسترش فعالیت‌ها و شکل‌گیری اعتماد میان ما و مشتریان، همکاران بیشتری به مجموعه پیوستند.</p>
        <p>سال‌ها بعد، نسل دوم خانواده پس از تحصیلات تکمیلی وارد مجموعه شد و در کنار نسل اول، تجربهٔ تولید را از نزدیک آموخت. از آن زمان، پیوند دانش مهندسی با تجربهٔ کارگاهی در کار ما پررنگ‌تر شد. برای ما، طراحی زمانی به نیاز صنعت پاسخ می‌دهد که شناخت فنی، ساخت قالب و تولید قطعه از ابتدا در کنار هم دیده شوند.</p>
        <p>این نگاه، همکاری ما با بخش علمی را هم گسترش داد. امروز نمایندهٔ رسمی آزمایشگاه متالورژی دانشگاه صنعتی شریف هستیم. آزمایش‌های متالورژی در دانشگاه انجام می‌شوند و دانشگاه در بخشی از فعالیت‌های طراحی نیز مشارکت دارد. این همکاری، دانش طراحی و آزمایش را به تجربهٔ تولید در کارگاه پیوند می‌دهد.</p>
        <p>امروز در حوزهٔ خدمات مهندسی و صنعتی، از مشاوره و طراحی قطعه و قالب تا قالب‌سازی، پرس‌کاری و فرزکاری CNC فعالیت می‌کنیم و از طریق همکاری با آزمایشگاه دانشگاه، خدمات آزمایش متالورژی را نیز ارائه می‌دهیم. مسیر ما از یک کارگاه خانوادگی آغاز شد و با همراهی دو نسل ادامه یافت؛ مسیری که در آن دانش مهندسی و تجربهٔ ساخت، کنار هم برای پاسخ‌گویی به نیازهای صنعت به کار گرفته می‌شوند.</p>
        <a class="text-link" href="#services">آشنایی با خدمات <span aria-hidden="true">←</span></a>
      </div>
    </section>

    <section class="services full-section" id="services" aria-labelledby="services-title">
      <div class="services__shell">
        <header class="services__heading">
          <h2 id="services-title">خدمات ما</h2>
        </header>
        <div class="services-tabs" role="tablist" aria-label="انتخاب خدمت">
          <button class="services-tabs__button is-active" id="service-tab-design" type="button" role="tab" aria-selected="true" aria-controls="service-panel-design" data-service-tab="design">طراحی</button>
          <button class="services-tabs__button" id="service-tab-build" type="button" role="tab" aria-selected="false" aria-controls="service-panel-build" data-service-tab="build" tabindex="-1">ساخت</button>
          <button class="services-tabs__button" id="service-tab-test" type="button" role="tab" aria-selected="false" aria-controls="service-panel-test" data-service-tab="test" tabindex="-1">آزمایش</button>
        </div>
        <div class="services-panels">
          <section class="service-panel is-active" id="service-panel-design" role="tabpanel" aria-labelledby="service-tab-design" style="--service-image: url('/images/services/design.png'); --service-position: center">
            <div class="service-panel__copy"><p class="eyebrow">خدمات صنعتی محمدی‌نیا</p><h3>طراحی</h3><p>هر پروژه با یک نیاز فنی شروع می‌شود؛ گاهی نقشه آماده است و گاهی باید مسیر ساخت از ابتدا روشن شود. ما با بررسی نیاز، نقشه یا نمونه و ارائهٔ مشاورهٔ فنی، طراحی را با روش تولید هماهنگ می‌کنیم. توانمندی‌های این بخش شامل طراحی قطعات صنعتی و طراحی قالب‌های سنبه برای کشش عمیق، ماتریس برای برش و خم، و قالب‌های ترکیبی برای اجرای چند مرحلهٔ شکل‌دهی است.</p></div>
          </section>
          <section class="service-panel" id="service-panel-build" role="tabpanel" aria-labelledby="service-tab-build" style="--service-image: url('/images/services/build.png'); --service-position: 38% center" hidden>
            <div class="service-panel__copy"><p class="eyebrow">خدمات صنعتی محمدی‌نیا</p><h3>ساخت</h3><p>وقتی طرح آماده شد، نوبت ساخت و تولید است. ما قابلیت‌های قالب‌سازی، پرس‌کاری ورق و فرزکاری CNC را در یک مجموعه دنبال می‌کنیم: ساخت قالب‌های سنبه، ماتریس و ترکیبی؛ پرس‌کاری ضربه‌ای و هیدرولیک؛ و فرزکاری CNC سه‌محور و چهارمحور. کنار هم بودن این توانمندی‌ها کمک می‌کند مسیر ساخت قالب و تولید قطعه را پیوسته پیش ببریم.</p></div>
          </section>
          <section class="service-panel" id="service-panel-test" role="tabpanel" aria-labelledby="service-tab-test" style="--service-image: url('/images/services/testing.png'); --service-position: 38% center" hidden>
            <div class="service-panel__copy"><p class="eyebrow">خدمات صنعتی محمدی‌نیا</p><h3>آزمایش</h3><p>برای انتخاب روش ساخت، شناخت رفتار و ویژگی‌های ماده هم اهمیت دارد. از طریق همکاری مستقیم با آزمایشگاه متالورژی دانشگاه صنعتی شریف، خدمات متالوگرافی، آنالیز شیمیایی، آزمون‌های کشش و خستگی و بیش از ۱۸۰ آزمون دیگر متناسب با نیاز صنعت را ارائه می‌کنیم. ما نمایندهٔ رسمی آزمایشگاه متالورژی این دانشگاه هستیم و آزمون‌ها در آزمایشگاه دانشگاه انجام می‌شوند.</p></div>
          </section>
        </div>
      </div>
    </section>

    <section class="projects full-section" id="projects" aria-labelledby="projects-title">
      <div class="section-shell">
        <header class="section-heading">
          <div><p class="eyebrow">از نزدیک ببینید</p><h2 id="projects-title">نمونه‌کارها</h2></div>
          <div class="project-controls" role="group" aria-label="ناوبری نمونه‌کارها"><button type="button" data-project-scroll="-1" aria-label="نمونه‌کار قبلی"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button><button type="button" data-project-scroll="1" aria-label="نمونه‌کار بعدی"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button></div>
        </header>
        <div class="project-grid" id="project-track">
          {portfolio.map((project, index) => (
            <figure class="project-card" tabindex="0">
              <div class="project-card__image"><img src={project.image} alt={project.alt} loading="lazy" /></div>
              <figcaption><span>پروژهٔ ۰{index + 1}</span><strong>{project.title}</strong><small aria-hidden="true">↗</small></figcaption>
            </figure>
          ))}
        </div>
        <p class="projects__hint">برای دیدن جزئیات، نشانگر را روی تصویر ببرید</p>
      </div>
    </section>

    <section class="contact full-section" id="contact" aria-labelledby="contact-title">
      <div class="section-shell contact__layout">
        <div class="contact__main">
          <p class="eyebrow">با ما در ارتباط باشید</p>
          <h2 id="contact-title">پروژهٔ بعدی شما<br />از یک گفت‌وگو شروع می‌شود.</h2>
          <p>برای دریافت مشاوره یا شروع همکاری، پیام خود را برای ما بفرستید.</p>
          <form class="contact-form" action={`mailto:${contact.email}`} method="post" enctype="text/plain">
            <label>نام و نام خانوادگی<input name="name" autocomplete="name" placeholder="نام شما" required /></label>
            <label>ایمیل<input type="email" name="email" autocomplete="email" placeholder="name@example.com" required dir="ltr" /></label>
            <label class="contact-form__message">پیام شما<textarea name="message" rows="3" placeholder="کمی دربارهٔ نیازتان بنویسید" required></textarea></label>
            <button class="button button--primary" type="submit">ارسال پیام <span aria-hidden="true">←</span></button>
          </form>
        </div>
        <aside class="contact__details" aria-label="اطلاعات تماس">
          <div class="contact__mark" aria-hidden="true">م</div>
          <p>خدمات صنعتی<br />محمدی‌نیا</p>
          <div><span>ایمیل</span><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></div>
          <div><span>شماره تماس</span>{contact.mobile.map((phone) => <a href={`tel:${phone}`} dir="ltr">{persianDigits(phone)}</a>)}</div>
          <div><span>تلفن دفتر</span>{contact.office.map((phone) => <a href={`tel:${phone}`} dir="ltr">{persianDigits(phone)}</a>)}</div>
          <small>© خدمات صنعتی محمدی‌نیا</small>
        </aside>
      </div>
    </section>
  </main>


  <script>
    const serviceTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-service-tab]')];
    const servicePanels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"][id^="service-panel-"]')];
    const activateServiceTab = (tab: HTMLButtonElement, focus = false) => {
      serviceTabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      servicePanels.forEach((panel) => {
        const selected = panel.id === tab.getAttribute('aria-controls');
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });
      if (focus) tab.focus();
    };
    serviceTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateServiceTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? serviceTabs.length - 1 :
          (index + (event.key === 'ArrowLeft' ? 1 : -1) + serviceTabs.length) % serviceTabs.length;
        activateServiceTab(serviceTabs[next], true);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-service-scroll], [data-project-scroll]').forEach((button) => button.addEventListener('click', () => {
      const isService = button.hasAttribute('data-service-scroll');
      const track = document.querySelector<HTMLElement>(isService ? '#service-track' : '#project-track');
      const card = track?.firstElementChild as HTMLElement | null;
      if (!track || !card) return;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      const rtlDirection = getComputedStyle(track).direction === 'rtl' ? -1 : 1;
      const movement = Number(button.dataset.serviceScroll ?? button.dataset.projectScroll) * (card.offsetWidth + gap) * rtlDirection;
      track.scrollBy({ left: movement, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }));

    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.rail-links a[href^="#"], .mobile-nav a[href^="#"]');
    const sections = [...new Set([...sectionLinks].map((link) => document.querySelector<HTMLElement>(link.hash)).filter((section): section is HTMLElement => !!section))];
    const updateNavigation = () => {
      const marker = window.scrollY + window.innerHeight * 0.42;
      const active = [...sections].reverse().find((section) => section.offsetTop <= marker) ?? sections[0];
      sectionLinks.forEach((link) => {
        const current = link.hash === `#${active?.id}`;
        link.classList.toggle('is-active', current);
        if (current) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', updateNavigation, { passive: true });
    window.addEventListener('resize', updateNavigation);
    updateNavigation();
  </script>
</BaseLayout>
